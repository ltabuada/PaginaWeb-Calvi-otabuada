# Firebase — ninguno de estos valores es secreto: van al bundle del navegador
# por diseño. La seguridad real viene de Firebase Auth + las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — tampoco son secretos. El upload preset tiene que ser "unsigned".
# El API Secret de Cloudinary NUNCA va acá: no se usa desde el navegador.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

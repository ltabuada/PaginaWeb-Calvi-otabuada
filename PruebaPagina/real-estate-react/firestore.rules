rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un admin es alguien autenticado que además tiene un documento en /admins.
    // Se usa una colección en vez de UIDs hardcodeados para poder dar de alta a
    // un segundo empleado desde la consola, sin redeploy de reglas.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // El formulario de contacto es público, así que sin validar la forma
    // cualquiera podría escribir millones de documentos y quemar la cuota.
    function consultaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'tipo','nombre','email','telefono','mensaje','asunto',
               'propiedadId','propiedadTitulo','fecha','leida','respondida'
             ])
        && d.keys().hasAll(['nombre','email','mensaje','fecha','leida','respondida'])
        && d.nombre  is string && d.nombre.size()  > 0 && d.nombre.size()  <= 120
        && d.email   is string && d.email.size() <= 200
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.mensaje is string && d.mensaje.size() > 0 && d.mensaje.size() <= 3000
        // Un visitante no puede crear una consulta ya marcada como leída.
        && d.leida == false
        && d.respondida == false
        // Obliga a usar serverTimestamp().
        && d.fecha == request.time;
    }

    // El sitio público lee; solo el admin escribe.
    match /propiedades/{docId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    match /emprendimientos/{docId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // Cualquiera puede mandar una consulta; solo el admin las lee.
    match /consultas/{docId} {
      allow create: if consultaValida();
      allow read, update, delete: if esAdmin();
    }

    // exists() se evalúa con privilegios de servidor, así que la colección
    // puede estar cerrada del todo y esAdmin() sigue funcionando.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Cualquier colección futura queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
